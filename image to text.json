      "parameters": {
        "jsCode": "const text = $json[\"ParsedResults\"][0][\"ParsedText\"]; // Get the parsed text from OCR\n\nconst parsedData = {\n    date: text.match(/Date\\s+([\\s\\S]*?)Expense Type/)?.[1]?.trim(),\n    expenseType: text.match(/Expense Type\\s+([\\s\\S]*?)Description/)?.[1]?.trim(),\n    description: text.match(/Description\\s+([\\s\\S]*?)Amount \\(USD\\)/)?.[1]?.trim(),\n    amount: text.match(/Amount \\(USD\\)\\s+([\\s\\S]*)/)?.[1]?.trim(),\n};\n\nreturn [{ json: parsedData }];\n"
      },
