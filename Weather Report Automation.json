      "name": "Weather Pull"
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming JSON\nconst data = items[0].json;\n\n// Get today's date in format \"YYYY-MM-DD\" (UTC)\nconst today = new Date().toISOString().split('T')[0];\n\n// Get time and temperature arrays\nconst times = data.hourly.time;\nconst temps = data.hourly.temperature_2m;\n\n// Collect today's temperatures\nlet todaysTemps = [];\n\nfor (let i = 0; i < times.length; i++) {\n  if (times[i].startsWith(today)) {\n    todaysTemps.push(temps[i]);\n  }\n}\n\n// Handle edge case: no data for today\nif (todaysTemps.length === 0) {\n  return [{ json: { error: \"No temperature data found for today\" } }];\n}\n\n// Calculate high and low\nconst high = Math.max(...todaysTemps);\nconst low = Math.min(...todaysTemps);\n\n// Return result\nreturn [\n  {\n    json: {\n      date: today,\n      high_temperature: high,\n      low_temperature: low\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
